---
import Section from '../components/Section.astro';
import { trust } from '../data/site';
---

<Section
  id="trust"
  tone="warm"
  eyebrow="Credentials"
  title="Who is treating you"
  intro="Every treatment at IASO MD is performed or directly supervised by a physician. No rotating injectors, no unlicensed delegation."
>
  <div class="grid gap-16 lg:grid-cols-[1fr_1fr] lg:gap-20">
    <!-- ----------------------------------------------------- Credentials -->
    <div data-reveal>
      <dl class="divide-y divide-gold/20 border-y border-gold/30">
        {
          trust.credentials.map((item) => (
            <div class="grid gap-1 py-5 sm:grid-cols-[11rem_1fr] sm:gap-6">
              <dt class="text-[11px] font-medium uppercase tracking-[0.22em] text-neutral">
                {item.label}
              </dt>
              <dd class="text-ink">{item.value}</dd>
            </div>
          ))
        }
      </dl>

      {
        trust.waRegistration && (
          <p class="mt-8 flex items-start gap-3 text-sm leading-relaxed text-ink">
            <svg
              class="mt-0.5 h-4 w-4 shrink-0 text-gold"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8 1.5 13.5 4v4.2c0 3-2.3 5.4-5.5 6.3-3.2-.9-5.5-3.3-5.5-6.3V4L8 1.5Z"
              />
            </svg>
            <span>{trust.waRegistration}</span>
          </p>
        )
      }

      <p class="mt-6 border-l-2 border-gold pl-4 text-sm leading-relaxed text-ink">
        {trust.injectables}
      </p>
    </div>

    <!-- -------------------------------------------------------- Reviews -->
    <div>
      <h3 class="text-[11px] font-medium uppercase tracking-[0.22em] text-neutral">
        What members say
      </h3>
      <ul class="mt-8 space-y-8">
        {
          trust.reviews.map((review) => (
            <li class="border-l border-gold/40 pl-6" data-reveal>
              <blockquote>
                <p class="font-serif text-xl leading-snug text-ink italic">
                  {review.quote}
                </p>
              </blockquote>
              <p class="mt-3 text-[11px] font-medium uppercase tracking-[0.22em] text-neutral">
                {review.attribution}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>
