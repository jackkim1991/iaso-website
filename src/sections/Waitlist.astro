---
import { site, forms, legal } from '../data/site';

const action = `https://formspree.io/f/${forms.waitlistId}`;
const needsSetup = forms.waitlistId.includes('[');
---

<section id="waitlist" class="bg-ink py-24 sm:py-32">
  <div class="mx-auto max-w-3xl px-6 text-center lg:px-10" data-reveal>
    <p class="eyebrow eyebrow--light">Coming Soon</p>
    <h2 class="mt-5 font-serif text-4xl text-cream sm:text-5xl">
      Join the founding waitlist
    </h2>
    <hr class="rule-gold--short mx-auto mt-8" />
    <p class="mt-8 text-lg leading-relaxed text-cream/70">
      {site.openingStatus} Waitlist members hear first about opening dates,
      founding-member pricing, and the first appointment slots.
    </p>

    {
      needsSetup && import.meta.env.DEV && (
        <p class="mx-auto mt-8 max-w-lg border border-dashed border-gold/60 p-4 text-sm text-cream/70">
          Setup: replace <code>forms.waitlistId</code> in <code>src/data/site.ts</code>{' '}
          with your Formspree form ID before launch.
        </p>
      )
    }

    <form
      action={action}
      method="POST"
      class="mx-auto mt-12 flex max-w-xl flex-col gap-4 sm:flex-row"
    >
      <div class="flex-1 text-left">
        <label
          for="waitlist-email"
          class="block text-[11px] font-medium uppercase tracking-[0.22em] text-cream/60"
        >
          Email address
        </label>
        <input
          id="waitlist-email"
          name="email"
          type="email"
          autocomplete="email"
          required
          placeholder="you@example.com"
          class="mt-2 w-full border border-gold/40 bg-transparent px-4 py-3 text-cream placeholder:text-cream/40 focus:border-gold focus:outline-none"
        />
      </div>

      <input type="hidden" name="_subject" value="IASO MD — waitlist signup" />
      <input
        type="text"
        name="_gotcha"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
        class="hidden"
      />

      <button
        type="submit"
        class="mt-2 shrink-0 self-end rounded-full bg-gold px-9 py-4 text-[11px] font-semibold uppercase tracking-[0.18em] text-ink transition-colors duration-300 hover:bg-cream sm:mt-0"
      >
        Join the Waitlist
      </button>
    </form>

    <p class="mx-auto mt-8 max-w-lg text-sm leading-relaxed text-cream/50">
      {legal.phi} We use your email only to tell you when IASO MD opens, and you
      can unsubscribe at any time.
    </p>
  </div>
</section>
