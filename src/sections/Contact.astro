---
import Section from '../components/Section.astro';
import { contact, legal } from '../data/site';

const directionsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(contact.mapQuery)}`;
const labelClass = 'block text-[11px] font-medium uppercase tracking-[0.22em] text-neutral';

/* No form backend is wired up yet, so the site asks people to email or call
   rather than posting into a void. Restore the form here once a backend is
   chosen — see "Turning the forms back on" in the README. */
const emailReady = !contact.email.startsWith('[');
const phoneReady = !contact.phone.startsWith('[');
---

<Section
  id="contact"
  eyebrow="Contact"
  title="Get in touch"
  intro="Questions about membership, treatments, or whether IASO MD is the right fit — ask before you join."
>
  <div class="grid gap-16 lg:grid-cols-2 lg:gap-24">
    <div data-reveal>
      <div
        class="flex aspect-[4/3] w-full flex-col items-center justify-center border border-gold/40 bg-cream-warm px-8 text-center"
        role="img"
        aria-label="Placeholder for the clinic location map"
      >
        <span class="eyebrow">Location</span>
        <p class="mt-4 font-serif text-2xl text-ink">[MAP EMBED]</p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-neutral">
          Add the embed once the address is confirmed — see CONTENT-CHECKLIST.md.
        </p>
      </div>

      <dl class="mt-10 space-y-8">
        <div>
          <dt class={labelClass}>Address</dt>
          <dd class="mt-2 text-lg text-ink">
            <address class="not-italic">
              {contact.streetAddress}<br />
              {contact.addressLocality}, {contact.addressRegion} {contact.postalCode}
            </address>
            <a
              href={directionsUrl}
              class="mt-1 inline-flex min-h-[44px] items-center text-sm text-gold-text underline underline-offset-4 hover:text-ink"
              rel="noopener"
            >
              Get directions
            </a>
          </dd>
        </div>

        <div>
          <dt class={labelClass}>Hours</dt>
          <dd class="mt-3">
            <ul class="space-y-2">
              {
                contact.hours.map((h) => (
                  <li class="flex justify-between gap-6 border-b border-gold/20 pb-2 text-ink">
                    <span>{h.days}</span>
                    <span class="text-neutral">{h.time}</span>
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>
      </dl>
    </div>

    <div data-reveal>
      <div class="border border-gold/30 bg-cream-warm p-8 sm:p-10">
        <p class="eyebrow">Reach us directly</p>
        <h3 class="mt-4 font-serif text-3xl text-ink">
          Email or call — a physician reads every message.
        </h3>
        <hr class="rule-gold mt-8" data-draw />

        <dl class="mt-8 space-y-8">
          <div>
            <dt class={labelClass}>Email</dt>
            <dd class="mt-2 font-serif text-2xl break-words text-ink">
              {
                emailReady ? (
                  <a
                    href={`mailto:${contact.email}`}
                    class="underline decoration-gold decoration-1 underline-offset-8 hover:text-gold-text"
                  >
                    {contact.email}
                  </a>
                ) : (
                  contact.email
                )
              }
            </dd>
          </div>

          <div>
            <dt class={labelClass}>Phone</dt>
            <dd class="mt-2 font-serif text-2xl text-ink">
              {
                phoneReady ? (
                  <a
                    href={contact.phoneHref}
                    class="underline decoration-gold decoration-1 underline-offset-8 hover:text-gold-text"
                  >
                    {contact.phone}
                  </a>
                ) : (
                  contact.phone
                )
              }
            </dd>
          </div>
        </dl>
      </div>

      <aside
        class="mt-8 border-l-2 border-gold bg-cream p-6"
        aria-label="Notice about health information"
      >
        <p class="eyebrow">Please note</p>
        <p class="mt-3 leading-relaxed text-ink">
          Please do not include medical or health information in your message.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-neutral">
          Email is not secure or HIPAA-compliant and is not monitored for urgent
          needs. For a medical emergency call 911.
        </p>
      </aside>

      <p class="mt-8 text-sm leading-relaxed text-neutral">{legal.disclaimer}</p>
    </div>
  </div>
</Section>
