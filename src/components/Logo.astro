---
import fs from 'node:fs';
import path from 'node:path';

export interface Props {
  /** "light" for dark grounds, "dark" for the off-white ground. */
  tone?: 'light' | 'dark';
  /** header = 40px desktop / 28px mobile. footer = 32px. */
  variant?: 'header' | 'footer';
  class?: string;
  eager?: boolean;
}

const { tone = 'dark', variant = 'header', class: className = '', eager = false } =
  Astro.props;

/**
 * Prefer an SVG once the corrected wordmark is commissioned; fall back to the
 * current PNG; fall back again to a pure-type wordmark if neither exists.
 *
 * Only the ICON is used here — the name is set in type beside it. The supplied
 * logo.png bakes in the words "IASO medical", which renders about 8px tall at
 * header size and contradicts the IASO MD wordmark next to it. Once the new
 * mark.svg (icon only) lands in /public, it is picked up automatically.
 */
const publicDir = path.join(process.cwd(), 'public');
const candidates = ['mark.svg', 'logo.svg', 'logo.png'];
const found = candidates.find((file) => fs.existsSync(path.join(publicDir, file)));
const src = found ? `/${found}` : null;

const markSize = variant === 'footer' ? 'h-8' : 'h-7 sm:h-10';
const wordSize = variant === 'footer' ? 'text-lg' : 'text-lg sm:text-xl';
const wordColor = tone === 'light' ? 'text-cream' : 'text-ink';
const accentColor = tone === 'light' ? 'text-gold-light' : 'text-gold-text';
/* Clear space = half the mark height: 20px around a 40px mark. */
const clearSpace = variant === 'footer' ? 'gap-3' : 'gap-3 sm:gap-4';
---

<span class={`flex items-center ${clearSpace} ${className}`}>
  {
    src && (
      <img
        src={src}
        alt=""
        aria-hidden="true"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class={`${markSize} w-auto shrink-0`}
      />
    )
  }
  <span class={`wordmark ${wordSize} ${wordColor}`}>
    Iaso <span class={accentColor}>MD</span>
  </span>
</span>
