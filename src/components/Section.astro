---
import SplitWords from './SplitWords.astro';

export interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  tone?: 'cream' | 'warm' | 'ink';
  align?: 'center' | 'left';
  class?: string;
}

const {
  id,
  eyebrow,
  title,
  intro,
  tone = 'cream',
  align = 'center',
  class: className = '',
} = Astro.props;

const toneClass = {
  cream: 'bg-cream text-ink',
  warm: 'bg-cream-warm text-ink',
  ink: 'bg-ink text-cream/80',
}[tone];

const headingClass = tone === 'ink' ? 'text-cream' : 'text-ink';
const introClass = tone === 'ink' ? 'text-cream/70' : 'text-neutral';
const eyebrowClass = tone === 'ink' ? 'eyebrow eyebrow--light' : 'eyebrow';
const alignClass = align === 'center' ? 'text-center mx-auto' : 'text-left';
---

<section id={id} class={`${toneClass} py-14 sm:py-24 lg:py-32 ${className}`}>
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    {
      (eyebrow || title || intro) && (
        <div class={`max-w-2xl ${alignClass} mb-12 sm:mb-16 lg:mb-20`}>
          {eyebrow && <p class={eyebrowClass} data-reveal>{eyebrow}</p>}
          {title && (
            <h2 class={`mt-5 ${headingClass}`} data-split>
              <SplitWords text={title} />
            </h2>
          )}
          <hr
            class={`rule-gold--short mt-8 ${align === 'center' ? 'mx-auto' : ''}`}
            data-draw
          />
          {intro && <p class={`mt-8 text-lg leading-relaxed ${introClass}`} data-reveal>{intro}</p>}
        </div>
      )
    }
    <slot />
  </div>
</section>
