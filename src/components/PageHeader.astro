---
export interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section class="border-b border-gold/25 bg-ink">
  <div class="mx-auto max-w-7xl px-6 pb-24 pt-28 sm:pt-36 lg:px-10">
    <div class="max-w-3xl" data-reveal>
      {eyebrow && <p class="eyebrow eyebrow--light">{eyebrow}</p>}
      <h1 class="mt-5 font-serif text-5xl leading-[1.1] text-cream sm:text-6xl">
        {title}
      </h1>
      <hr class="rule-gold--short mt-8" />
      {intro && <p class="mt-8 text-lg leading-relaxed text-cream/70">{intro}</p>}
    </div>
  </div>
</section>
