---
import Logo from './Logo.astro';
import { nav } from '../data/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  if (href.startsWith('/#')) return false;
  return current === href.replace(/\/$/, '');
};
---

<header
  class="sticky top-0 z-50 border-b border-gold/25 bg-cream/90 backdrop-blur-md no-print"
>
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6 lg:px-10">
    <a
      href="/"
      class="group -m-2 p-2"
      aria-label="IASO MD — home"
    >
      <Logo tone="dark" size={44} eager />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-8 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'text-[11px] font-medium uppercase tracking-[0.18em] text-muted transition-colors hover:text-ink',
              isActive(item.href) && 'text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/waitlist"
        class="rounded-full bg-gold px-6 py-3 text-[11px] font-semibold uppercase tracking-[0.18em] text-ink transition-colors hover:bg-ink hover:text-cream"
      >
        Join the Waitlist
      </a>
    </nav>

    <button
      type="button"
      id="nav-toggle"
      class="-mr-2 flex items-center gap-2 p-2 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="text-[11px] font-medium uppercase tracking-[0.18em] text-muted">
        Menu
      </span>
      <svg
        class="h-5 w-5 text-ink"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>

  <div id="mobile-nav" hidden class="border-t border-gold/25 bg-cream lg:hidden">
    <nav aria-label="Primary (mobile)" class="mx-auto max-w-7xl px-6 py-6">
      <ul class="flex flex-col divide-y divide-gold/15">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="block py-4 font-serif text-2xl text-ink transition-colors hover:text-gold-deep"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="/waitlist"
        class="mt-6 block rounded-full bg-gold px-6 py-4 text-center text-[11px] font-semibold uppercase tracking-[0.18em] text-ink"
      >
        Join the Waitlist
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var toggle = document.getElementById('nav-toggle');
    var panel = document.getElementById('mobile-nav');
    if (!toggle || !panel) return;

    var setOpen = function (open) {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', function () {
      setOpen(panel.hidden);
    });

    // Close after following an in-page anchor, and on Escape.
    panel.addEventListener('click', function (event) {
      if (event.target instanceof HTMLAnchorElement) setOpen(false);
    });
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
  })();
</script>
