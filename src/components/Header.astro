---
import Logo from './Logo.astro';
import { nav } from '../data/site';
---

<header
  class="sticky top-0 z-50 border-b border-gold/25 bg-cream/90 backdrop-blur-md no-print"
>
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between gap-6 px-6 lg:px-8 xl:px-10">
    <a href="/" class="group -m-2 shrink-0 p-2" aria-label="IASO MD — home">
      <Logo tone="dark" variant="header" eager />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-4 lg:flex xl:gap-7">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="flex items-center text-[0.6875rem] font-medium uppercase tracking-[0.06em] whitespace-nowrap text-neutral transition-colors hover:text-ink xl:text-[0.8125rem] xl:tracking-[0.08em]"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <!-- The single high-contrast CTA. Visible at every breakpoint, never
           folded into the hamburger. -->
      <a
        href="/#contact"
        class="tap lift label flex items-center whitespace-nowrap rounded-full bg-gold px-5 text-ink transition-colors hover:bg-ink hover:text-cream sm:px-6 lg:px-5 xl:px-6"
      >
        Contact
      </a>

      <button
        type="button"
        id="nav-toggle"
        class="tap -mr-2 flex items-center justify-center gap-2 p-2 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="sr-only">Menu</span>
        <svg
          class="h-6 w-6 text-ink"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" hidden class="border-t border-gold/25 bg-cream lg:hidden">
    <nav aria-label="Primary (mobile)" class="mx-auto max-w-7xl px-6 py-4">
      <ul class="flex flex-col divide-y divide-gold/15">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="tap flex items-center py-4 font-serif text-2xl text-ink transition-colors hover:text-gold-text"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var toggle = document.getElementById('nav-toggle');
    var panel = document.getElementById('mobile-nav');
    if (!toggle || !panel) return;

    var setOpen = function (open) {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', function () {
      setOpen(panel.hidden);
    });

    // Close after following an in-page anchor, and on Escape.
    panel.addEventListener('click', function (event) {
      if (event.target instanceof HTMLAnchorElement) setOpen(false);
    });
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
  })();
</script>
