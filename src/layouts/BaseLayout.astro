---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, contact, physician } from '../data/site';

export interface Props {
  title: string;
  description?: string;
  /** Path only, e.g. "/404" — combined with site.url for canonical/OG. */
  path?: string;
  /** Absolute or root-relative image used for OG/Twitter cards. */
  ogImage?: string;
  /** Set on pages that should not appear in search results. */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  path = Astro.url.pathname,
  ogImage = '/og-image.png',
  noindex = false,
} = Astro.props;

const canonical = new URL(path, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;

// LocalBusiness / MedicalClinic structured data. Every NAP value is a
// placeholder until the real details land in src/data/site.ts.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  '@id': `${site.url}/#clinic`,
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  logo: new URL('/logo.png', site.url).href,
  image: ogImageUrl,
  description: site.description,
  slogan: site.tagline,
  priceRange: '$$$',
  telephone: contact.phone,
  email: contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.streetAddress,
    addressLocality: contact.addressLocality,
    addressRegion: contact.addressRegion,
    postalCode: contact.postalCode,
    addressCountry: contact.addressCountry,
  },
  medicalSpecialty: ['Dermatology', 'PrimaryCare'],
  availableService: [
    { '@type': 'MedicalTherapy', name: 'Korean aesthetics treatments' },
    { '@type': 'MedicalTherapy', name: 'Botox and neuromodulators' },
    { '@type': 'MedicalTherapy', name: 'Laser treatments' },
    { '@type': 'MedicalTherapy', name: 'Skin boosters' },
    { '@type': 'MedicalTherapy', name: 'Facials and glass-skin treatments' },
    { '@type': 'MedicalTherapy', name: 'K-beauty skincare consultation' },
    { '@type': 'MedicalTherapy', name: 'Direct Primary Care membership' },
  ],
  founder: {
    '@type': 'Physician',
    name: physician.name,
    medicalSpecialty: 'PrimaryCare',
  },
  openingHoursSpecification: contact.hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days,
    description: h.time,
  })),
  sameAs: contact.social.map((s) => s.href),
};
---

<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Icons generated from public/logo.png (see README: "Replacing the logo"). -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0b0b0b" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts: one stylesheet request, preconnected, swap so text paints immediately. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,600&family=Inter:wght@400;500;600&display=swap"
    />

    <script is:inline set:html={JSON.stringify(schema)} type="application/ld+json" />

    <!-- Runs before paint, so nothing is hidden unless we can reveal it again.
         .js       — scripting is available, the reveal fallback may hide things
         .css-scroll — the browser drives reveals itself, off the main thread -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.remove('no-js');
        root.classList.add('js');
        if (
          window.CSS &&
          CSS.supports &&
          CSS.supports('animation-timeline', 'view()')
        ) {
          root.classList.add('css-scroll');
        }
      })();
    </script>
  </head>

  <body class="bg-cream text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-ink focus:px-5 focus:py-3 focus:text-cream focus:text-sm focus:tracking-widest focus:uppercase"
    >
      Skip to content
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <!-- In-page navigation. Links keep real "#section" hrefs so they work
         without JavaScript and can be opened in a new tab, but a click scrolls
         instead of navigating, so the address bar stays a clean iasomd.com with
         no #fragment. A URL that does arrive with a hash (an old /services
         link, say) still lands on the right section, then the hash is stripped. -->
    <script is:inline>
      (function () {
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

        var goTo = function (id, behavior) {
          var target = document.getElementById(id);
          if (!target) return false;

          // Lenis owns the scroll position when it is running on desktop, so
          // scrollIntoView would fight it. Checked at click time because the
          // module script that creates it loads after this inline one.
          if (window.__lenis && behavior === 'smooth') {
            window.__lenis.scrollTo(target, { offset: -96 });
          } else {
            target.scrollIntoView({ behavior: behavior, block: 'start' });
          }

          // Move focus so keyboard and screen-reader users follow the jump.
          if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
          target.focus({ preventScroll: true });
          return true;
        };

        var stripHash = function () {
          history.replaceState(null, '', location.pathname + location.search);
        };

        document.addEventListener('click', function (event) {
          if (event.defaultPrevented || event.button !== 0) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

          var link = event.target.closest && event.target.closest('a[href*="#"]');
          if (!link) return;

          var url;
          try {
            url = new URL(link.getAttribute('href'), location.href);
          } catch (error) {
            return;
          }
          if (url.origin !== location.origin) return;
          if (url.pathname !== location.pathname) return;
          if (!url.hash || url.hash === '#') return;

          if (goTo(decodeURIComponent(url.hash.slice(1)), reduced.matches ? 'auto' : 'smooth')) {
            event.preventDefault();
          }
        });

        if (location.hash) {
          var landing = decodeURIComponent(location.hash.slice(1));
          requestAnimationFrame(function () {
            goTo(landing, 'auto');
            stripHash();
          });
        }
      })();
    </script>

    <!-- Scroll reveal + parallax. No dependencies. Both are skipped entirely
         when the visitor prefers reduced motion, and the reveal observer is
         skipped again when the browser drives the same animation itself. -->
    <script is:inline>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        var root = document.documentElement;

        // Moment 2: section reveal. Native scroll-driven CSS handles this
        // wherever it is supported; this observer is only the fallback.
        if (!root.classList.contains('css-scroll')) {
          var revealables = document.querySelectorAll('[data-reveal], [data-draw]');

          if ('IntersectionObserver' in window) {
            var io = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (entry) {
                  if (!entry.isIntersecting) return;
                  var el = entry.target;

                  // Stagger siblings 60ms apart so a group arrives as a group.
                  var siblings = el.parentElement
                    ? Array.prototype.filter.call(
                        el.parentElement.children,
                        function (node) {
                          return node.hasAttribute('data-reveal');
                        }
                      )
                    : [];
                  var index = siblings.indexOf(el);
                  if (index > 0) {
                    el.style.transitionDelay = Math.min(index, 6) * 60 + 'ms';
                  }

                  el.setAttribute('data-revealed', '');
                  io.unobserve(el);
                });
              },
              { rootMargin: '0px 0px -12% 0px', threshold: 0.08 }
            );
            revealables.forEach(function (el) {
              io.observe(el);
            });
          } else {
            revealables.forEach(function (el) {
              el.setAttribute('data-revealed', '');
            });
          }
        }

        var layers = document.querySelectorAll('.parallax-layer');
        if (layers.length) {
          var ticking = false;
          var onScroll = function () {
            if (ticking) return;
            ticking = true;
            window.requestAnimationFrame(function () {
              var y = window.scrollY;
              layers.forEach(function (layer) {
                layer.style.setProperty('--parallax-y', (y * 0.28).toFixed(1) + 'px');
              });
              ticking = false;
            });
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        }
      })();
    </script>

    <!-- Lenis smooth scroll — desktop pointer devices only, and never when the
         visitor prefers reduced motion. ~3KB; the nav scroll handler above
         hands off to it through window.__lenis when it is running. -->
    <script>
      const wantsMotion = window.matchMedia('(prefers-reduced-motion: no-preference)');
      const isDesktop = window.matchMedia('(min-width: 1024px) and (hover: hover) and (pointer: fine)');

      if (wantsMotion.matches && isDesktop.matches) {
        const { default: Lenis } = await import('lenis');
        const lenis = new Lenis({ duration: 1.05, smoothWheel: true });
        window.__lenis = lenis;

        const raf = (time) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }
    </script>
  </body>
</html>
