---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import WhyDpc from '../sections/WhyDpc.astro';
import Membership from '../sections/Membership.astro';
import HowItWorks from '../sections/HowItWorks.astro';
import Trust from '../sections/Trust.astro';
import About from '../sections/About.astro';
import Services from '../sections/Services.astro';
import GlowProgram from '../sections/GlowProgram.astro';
import Gallery from '../sections/Gallery.astro';
import Testimonials from '../sections/Testimonials.astro';
import Faq from '../sections/Faq.astro';
import Contact from '../sections/Contact.astro';
import ComingSoon from '../sections/ComingSoon.astro';
import { site } from '../data/site';
---

<BaseLayout
  title={`${site.name} — ${site.tagline}`}
  description={site.description}
  path="/"
>
  <!-- Order is the argument: DPC first, the physician, then everything the
       membership covers, and only then the aesthetics program. -->
  <Hero />
  <WhyDpc />
  <Membership />
  <HowItWorks />
  <Trust />
  <About />
  <Services />
  <GlowProgram />
  <Gallery />
  <Testimonials />
  <Faq />
  <Contact />
  <ComingSoon />
</BaseLayout>
