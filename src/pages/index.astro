---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import About from '../sections/About.astro';
import Services from '../sections/Services.astro';
import Membership from '../sections/Membership.astro';
import HowDpcWorks from '../sections/HowDpcWorks.astro';
import Gallery from '../sections/Gallery.astro';
import Testimonials from '../sections/Testimonials.astro';
import Faq from '../sections/Faq.astro';
import Contact from '../sections/Contact.astro';
import Waitlist from '../sections/Waitlist.astro';
import { site } from '../data/site';
---

<BaseLayout
  title={`${site.name} — ${site.tagline}`}
  description={site.description}
  path="/"
>
  <Hero />
  <About />
  <Services />
  <Membership />
  <HowDpcWorks />
  <Gallery />
  <Testimonials />
  <Faq />
  <Contact />
  <Waitlist />
</BaseLayout>
