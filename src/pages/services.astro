---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Services from '../sections/Services.astro';
import Gallery from '../sections/Gallery.astro';
import Waitlist from '../sections/Waitlist.astro';
---

<BaseLayout
  title="Services"
  description="Korean dermatology, neuromodulators, lasers, skin boosters, glass-skin facials, K-beauty consultations, and physician-led Direct Primary Care at IASO MD."
  path="/services"
>
  <PageHeader
    eyebrow="Services"
    title="Medical dermatology and primary care, under one roof"
    intro="Every treatment is chosen for the skin and the person in front of us — never from a menu of upsells."
  />
  <Services />
  <Gallery />
  <Waitlist />
</BaseLayout>
